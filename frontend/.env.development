# Local dev (Vite on http://localhost:5174)
# Do NOT set VITE_API_BASE_URL here — the app calls /api/v1/... on the same origin
# and Vite proxies /api to PHP at http://127.0.0.1:8888.
#
# Wrong: VITE_API_BASE_URL=http://localhost:5174
# Wrong: VITE_API_BASE_URL=http://localhost:5174/v1
# OK (only if you must call PHP directly): VITE_API_BASE_URL=http://127.0.0.1:8888
